generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  ANALYST
  ANALYST_ASSISTANT
  REVIEWER
  VIEWER
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
  ARCHIVED
}

enum FeedbackChannel {
  SUPPORT_TICKET
  APP_STORE_REVIEW
  NPS_SURVEY
  SALES_CALL_NOTE
  COMMUNITY_POST
}

model User {
  id            String            @id @default(uuid())
  name          String?
  email         String            @unique
  password      String
  image         String?
  emailVerified DateTime?
  isVerified    Boolean           @default(false)
  mfaEnabled    Boolean           @default(false)
  mfaSecret     String?
  mfaBackupCodes String[]         @default([])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  memberships     WorkspaceMember[]
  createdFeedback Feedback[]
  createdReports  Report[]
  sessions        Session[]
  accounts        Account[]
  auditLogs       AuditLog[]
}

model Workspace {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  description String?
  logo        String?
  industry    String?
  teamSize    String?
  apiKey      String            @unique @default(uuid())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  members     WorkspaceMember[]
  feedback    Feedback[]
  themes      FeedbackTheme[]
  reports     Report[]
  shareLinks  ShareLink[]
  auditLogs   AuditLog[]
  invitations InvitationToken[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        Role      @default(MEMBER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model InvitationToken {
  id          String    @id @default(uuid())
  email       String
  workspaceId String
  role        Role      @default(MEMBER)
  token       String    @unique
  expires     DateTime
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model FeedbackTheme {
  id          String     @id @default(uuid())
  workspaceId String
  title       String
  description String?
  color       String?    @default("emerald")
  growthRate  Float      @default(0.0)
  isSpike     Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feedbacks   Feedback[]

  @@index([workspaceId])
}

model Feedback {
  id             String          @id @default(uuid())
  workspaceId    String
  authorId       String?
  content        String          @db.Text
  channel        FeedbackChannel @default(SUPPORT_TICKET)
  company        String?
  rating         Int?            @default(5)
  category       String?         @default("General")
  priority       String?         @default("MEDIUM")
  product        String?         @default("Core Platform")
  source         String?         @default("Web Portal")
  tags           String[]        @default([])
  rationale      String?         @db.Text
  sentimentScore Float           @default(0.0)
  sentimentLabel String          @default("NEUTRAL")
  status         FeedbackStatus  @default(NEW)
  customerName   String?
  customerEmail  String?
  themeId        String?
  assignedToId   String?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author         User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  theme          FeedbackTheme?  @relation(fields: [themeId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([authorId])
  @@index([themeId])
}

model Report {
  id           String      @id @default(uuid())
  workspaceId  String
  authorId     String?
  title        String
  summary      String      @db.Text
  totalItems   Int         @default(0)
  avgSentiment Float       @default(0.0)
  pdfUrl       String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author       User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  shareLinks   ShareLink[]

  @@index([workspaceId])
  @@index([authorId])
}

model ShareLink {
  id          String    @id @default(uuid())
  token       String    @unique @default(uuid())
  reportId    String
  workspaceId String
  createdBy   String
  expiresAt   DateTime?
  revoked     Boolean   @default(false)
  accessCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  report      Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([reportId])
}

model AuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}