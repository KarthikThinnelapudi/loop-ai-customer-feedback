# Database
DATABASE_URL="postgresql://user:password@host:5432/loop_ai?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/loop_ai?sslmode=require"

# NextAuth
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="your-production-secret-key-32-chars-min"

# Environment Mode
DEMO_MODE="false"

# OAuth SSO Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Production Email (Resend API or SMTP)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="LOOP AI <noreply@your-domain.com>"

# Optional SMTP Alternative
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASS="your-sendgrid-api-key"